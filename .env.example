# Phantom.js environment variables. Copy to .env.local and fill in.

# Repo to analyze when running the demo (defaults to ./sample-repo).
PHANTOM_REPO_PATH=./

# GitHub (optional). A token raises the unauthenticated 60 req/hr API limit and
# enables larger/private repos. Public repos work without it.
GITHUB_TOKEN=

# Supabase — saved hunts ("the Grimoire"): list, revisit, annotate, and delete past
# exorcisms. If unset, the app falls back to an in-memory store (session-only; fine
# for the local demo). Configure these to persist across users/deploys, and run
# supabase/schema.sql once in your project.
SUPABASE_URL=
# Service role key bypasses RLS for server-side writes (never ship to the client).
SUPABASE_SERVICE_ROLE_KEY=
# Optional anon key, used only if a service role key isn't provided.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Redis — semantic cache of unchanged file ASTs to avoid re-parsing (ARCHITECTURE.md §3).
REDIS_URL=

# FOCUS (FinOps Open Cost & Usage Spec) billing export source for real cost data.
FOCUS_EXPORT_BUCKET=
FOCUS_PREFIX=

# LLM provider — only needed to drive the Hunter/Skeptic Chain-of-Thought from a
# real model. Without it, the loop runs on deterministic agents (fully functional).
ANTHROPIC_API_KEY=
