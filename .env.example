# Phantom.js environment variables. Copy to .env.local and fill in.

# Repo to analyze when running the demo (defaults to CWD if unset).
PHANTOM_REPO_PATH=./

# Supabase — used to log every "exorcism" (tool calls, CoT traces, PR, FinOps delta).
SUPABASE_URL=
SUPABASE_ANON_KEY=

# LLM provider — only needed to drive the Chain-of-Thought from a real model.
# Without this, the agent runs on deterministic policy guards (fully functional).
ANTHROPIC_API_KEY=
